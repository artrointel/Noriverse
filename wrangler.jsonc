{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noriverse-phase-one",
  "main": "apps/signaling/worker.ts",
  "compatibility_date": "2026-07-09",
  "vars": { "APP_ORIGIN": "https://artrointel.github.io" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "PROFILES", "class_name": "ProfileStore" },
      { "name": "FRIENDS", "class_name": "FriendGraph" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["ProfileStore"] },
    { "tag": "v3", "new_sqlite_classes": ["FriendGraph"] }
  ]
}
